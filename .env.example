# Infraestructura local (docker-compose usa estos valores; defaults de desarrollo)
MYSQL_ROOT_PASSWORD=dev_root_local
MYSQL_USER=panel_app
MYSQL_PASSWORD=dev_app_local
REDIS_PASSWORD=dev_redis_local

# Fase 2 — backend (apps/api/.env los reutiliza)
FIREBASE_PROJECT_ID=
# Ruta absoluta a la clave del service account (permisos 600, fuera del repo)
GOOGLE_APPLICATION_CREDENTIALS=
# Cuenta central que impersona el service account (Gmail/Calendar)
GOOGLE_IMPERSONATED_USER=
# ID del calendario compartido "Acuerdos · Plan Juárez"
GOOGLE_CALENDAR_ID=
